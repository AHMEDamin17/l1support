NODE_ENV=local
PORT=8080

# SLM configuration. Supports any OpenAI-compatible local or hosted small language model endpoint.
SLM_ENABLED=false
SLM_BASE_URL=http://localhost:11434/v1
SLM_API_KEY=ollama
SLM_MODEL=phi3:mini
SLM_TIMEOUT_MS=15000

# Mail Provider: "graph" (Microsoft 365), "imap" (Personal Gmail/Outlook), or "gmail" (Google OAuth)
MAIL_PROVIDER=gmail
MAIL_LOOKBACK_MINUTES=30
MAIL_POLL_SECONDS=60

# Gmail API Configuration
GMAIL_CLIENT_ID=your-google-cloud-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-cloud-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback

# Outlook Microsoft Graph optional mailbox watcher
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
MAILBOX_USER_ID=shared-support-mailbox@company.com

# IMAP Configuration (for personal email like Gmail, Outlook.com)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=aminkhizer377@gmail.com
IMAP_PASS=zksc hwlk eiji dkvi
IMAP_TLS=true

# Notifications / ticket integration placeholders
TEAMS_WEBHOOK_URL=
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
